# Database (see docs/architecture.md) — PostgreSQL接続文字列
# Web上でホスティングする場合、ホスティング先(Vercel等)が発行するPostgreSQLの
# 接続URLをそのままこの値として設定してください(ローカルの場合は自分で用意)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 外部検索プロバイダ (未設定時はモックプロバイダで動作する)
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE_ID=
YOUTUBE_API_KEY=
SNS_API_KEY=

# 株価データ: J-Quants (https://jpx-jquants.com/ 無料登録。証券会社口座は不要)
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=

# 開示書類: EDINET (https://disclosure2.edinet-fsa.go.jp/ 無料のSubscription-Key登録)
EDINET_SUBSCRIPTION_KEY=
# 企業名/証券コードでの検索APIが無いため、直近何日分を走査するか (既定30日)
EDINET_LOOKBACK_DAYS=30
